rules_version = '2';

/* ---------------------------------------------------------------------------
   LOCAL EMULATOR USE ONLY — never deploy this file.

   The real storage.rules resolves workspace membership with a cross-service
   Firestore lookup (firestore.exists / firestore.get). Those bindings are not
   available inside the Storage emulator: `firestore` evaluates to null there,
   the rule errors with "Null value error", and every upload comes back 403 —
   even though the same ruleset compiles cleanly and works against a real
   Firebase project.

   So that attachments can still be exercised locally, this variant keeps the
   path shape, the size cap and the accepted content types, and drops only the
   membership check. Point firebase.json at it while developing against the
   emulator:

     "storage": { "rules": "storage.emulator.rules" }

   Put it back to "storage.rules" before `firebase deploy`. Membership
   enforcement is verified against Firestore by `npm run test:rules`.
   --------------------------------------------------------------------------- */

service firebase.storage {
  match /b/{bucket}/o {

    function isAllowedType() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType ==
               'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType ==
               'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
    }

    match /workspaces/{wid}/items/{itemId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && isAllowedType();
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

# Firebase web app config.
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
# Copy this file to .env.local and fill in your project's real values.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKeyReplaceMe
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Origin used to build the email sign-in link and invite links.
# Leave unset in the browser build and it falls back to window.location.origin,
# which is the right answer for local dev and for Vercel/Netlify preview URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
